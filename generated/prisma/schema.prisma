generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Tarea {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(100)
  descripcion String   @db.Text
  creadaEn    DateTime @default(now()) @map("creada_en")

  @@map("tareas")
}
